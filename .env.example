# CAF 2027 Copilot — primer environment fajla.
# Kopirati u .env i popuniti stvarnim vrednostima. .env se NIKAD ne commit-uje
# (vidi .gitignore) — CLAUDE.md Sekcija 3, pravilo 4: Security by Design.

# --- PostgreSQL (admin/migracije) ---
POSTGRES_USER=caf_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=caf2027

# --- PostgreSQL (runtime aplikaciona rola, bez BYPASSRLS) ---
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://app_user:change_me@localhost:5432/caf2027

# --- PostgreSQL (SAMO za Alembic migracije — vlasnik baze, ima DDL prava) ---
# Mora odgovarati POSTGRES_USER/POSTGRES_PASSWORD iznad. Runtime ovo NE koristi.
ADMIN_DATABASE_URL=postgresql+asyncpg://caf_admin:change_me@localhost:5432/caf2027

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=caf_minio_admin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_EVIDENCE=caf-evidence
# Lokalno bez TLS-a; u produkciji MORA biti true (aplikacija inače ne starta).
MINIO_SECURE=false

# --- Antivirus (ClamAV clamd) — dokazi (api-contract-v1.md 6.1) ---
# clamd = svaki fajl se skenira; skener nedostupan -> 503 i fajl se NE čuva.
# disabled = SAMO lokalni razvoj bez ClamAV kontejnera (fajl dobija status
# "pending", nije verifikovan dokaz). U produkciji aplikacija odbija da starta.
AV_SCAN_MODE=clamd
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=60
MAX_EVIDENCE_BYTES=26214400

# --- JWT / Auth ---
JWT_SECRET_KEY=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Provider (popunjava se u Fazi 1 kad AI/Consensus agent odabere
#     stvaran, verifikovan model — CLAUDE.md Sekcija 2, napomena o AI modelima) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- i18n ---
DEFAULT_LOCALE=me
SUPPORTED_LOCALES=me,en

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Frontend (Next.js — čita se u build/runtime; NEXT_PUBLIC_* ide u browser bundle) ---
NEXT_PUBLIC_API_URL=http://localhost:8765
